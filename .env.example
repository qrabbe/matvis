# Copy to .env.local and fill in. NEVER commit real values.

# --- Convex (self-hosted local backend is the default) ---
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=
CONVEX_SELF_HOSTED_URL=
CONVEX_SELF_HOSTED_ADMIN_KEY=

# --- Matvis app (packages/app) ---
# The app reads two deployments: receipts from the CONNECTOR (above, ambient via
# ConvexProvider) and products from the CATALOG (below, called imperatively).
# Both are read-only from the app: it never mounts an auth provider, so every
# write path on the connector throws before it reaches a handler.
VITE_CATALOG_CONVEX_URL=

# --- Coop public product API ---
# The subscription key coop.se ships to every browser. It gates the public
# product API only, but it is Coop's key rather than ours, so it stays out of
# source. Read at runtime by the catalog's Coop ingest actions, which means it
# has to be set on the CATALOG Convex deployment itself, not just here:
#   bunx convex env set COOP_EXTERNAL_API_KEY <key> --cwd packages/catalog
# A `.env.local` copy only reaches locally-run tooling; the cron-driven ingest
# reads the deployment's own environment.
COOP_EXTERNAL_API_KEY=

# --- Catalog admin console ---
# The one shared password behind the ingest console at `<catalog portal>/#/admin`.
# There are no user accounts: signing in exchanges this for a session token, and
# the deployment stores only that token's SHA-256. Set it on the CATALOG
# deployment, next to the Coop key. It is never read anywhere else, so there is
# no reason to put it in a local `.env.local` at all:
#   bunx convex env set CATALOG_ADMIN_PASSWORD <password> --cwd packages/catalog
# Unset means the console cannot be signed into, which is the safe default.

# --- Sentry (optional) ---
VITE_SENTRY_DSN=
