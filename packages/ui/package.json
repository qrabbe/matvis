{
  "name": "@matvis/ui",
  "version": "0.0.0",
  "description": "Matvis UI",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./vite": {
      "types": "./vite.d.ts",
      "default": "./vite.js"
    },
    "./vitest": {
      "types": "./vitest.d.ts",
      "default": "./vitest.js"
    },
    "./app.css": "./src/app.css",
    "./wp-fallback.css": "./src/wp-fallback.css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qrabbe/matvis.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "dependencies": {
    "@wordpress/components": "^37.0.0",
    "@wordpress/compose": "^8.4.0",
    "@wordpress/dataviews": "^17.2.0",
    "@wordpress/icons": "^15.2.0",
    "@wordpress/theme": "^1.0.0",
    "@wordpress/ui": "^0.18.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.3",
    "@storybook/react-vite": "^10.5.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^10.5.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
