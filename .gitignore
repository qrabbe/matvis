# Dependencies
node_modules

# Build output
dist
dist-ssr
build
build-types

# Stray TS declaration artifacts (real ones live in gitignored build-types/)
*.d.ts.map
packages/connect/convex/**/*.d.ts
packages/connect/src/**/*.d.ts
!packages/connect/convex/_generated/**
storybook-static
*.tsbuildinfo

# Env / secrets
.env
.env.*
!.env.example
*.local

# Data dumps / large assets that must stay out of the public repo
*.zip
scrape/

# Local, uncommitted working notes / tickets (never committed)
tickets/
*_donotcommit.md

# Convex installed agent skills (restore via skills-lock.json)
packages/connect/.agents/
packages/connect/.claude/

# Self-hosted backend volumes / local infra
convex_backend/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editor / OS
.vscode/*
