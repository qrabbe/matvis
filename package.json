{
  "name": "matvis",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qrabbe/matvis.git"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "test": "bun test && vitest run",
    "build": "tsc -b",
    "build:site": "bun tools/build-site.ts",
    "clean": "tsc -b --clean",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "^3.8.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
